# DATABASE_URL doit cibler le conteneur PostgreSQL existant sur sgaec-v3_default.
# Encoder les caractères spéciaux du mot de passe au format URL.
DATABASE_URL=postgresql://postgres:REMPLACER_PAR_VOTRE_MOT_DE_PASSE@postgres:5432/sgaec?schema=sgaec
# Ne pas utiliser cette valeur sur un serveur public.
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-chars
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_TTL_MINUTES=30
AUTH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
